{
  "name": "cody",
  "version": "0.1.0",
  "description": "CODY – Privacy-first local AI coding workspace",
  "main": "src/main/main.js",
  "author": "CODY",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "electron": "^33.2.1",
    "eslint": "^9.14.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "openai": "^4.73.0",
    "zod": "^3.23.8"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/out/"
    ]
  }
}
